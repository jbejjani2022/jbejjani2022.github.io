---
// The hedgehog walking lightly over quicksand, with the Huxley passage it comes from set as the sand
// itself: a block of small text directly under the drawn ground line, covered in "invisible ink" that
// parts under the pointer (src/scripts/sand.ts). Without JS the passage is simply readable.
import { Image } from 'astro:assets';
import lightly from '../assets/fog/lightly.png';

// The drawing's ink spans x 82–1915 and y 80–346 of its 1995×426 canvas. The styles below scale it so
// that those 1833px of ink run the full width of the text column, and crop it to y 70–352.
//
// GROUND is the y of the underside of the drawn ground line, sampled at 97 evenly spaced columns
// across the ink. The sand canvas starts at y = SAND_TOP, a little above the line's highest point, and
// is told how far down the line is at each column (as a fraction of its width), so the sand fills
// right up to the line.
const INK_WIDTH = 1833;
const SAND_TOP = 298;
// prettier-ignore
const GROUND = [
  333, 336, 333, 331, 334, 338, 342, 343, 340, 337, 336, 329, 330, 332, 334, 338, 340, 337, 334, 330, 322, 318, 312,
  310, 308, 307, 308, 316, 325, 330, 334, 336, 337, 337, 334, 330, 324, 320, 317, 320, 321, 321, 323, 326, 327, 328,
  326, 322, 321, 316, 313, 310, 309, 310, 310, 309, 307, 308, 306, 304, 306, 307, 307, 306, 302, 305, 307, 307, 309,
  312, 316, 317, 318, 318, 318, 318, 317, 314, 317, 321, 323, 322, 322, 321, 321, 320, 321, 324, 329, 332, 336, 343,
  346, 345, 343, 336, 336,
];
const surface = GROUND.map((y) => ((y + 2 - SAND_TOP) / INK_WIDTH).toFixed(4)).join(' ');
---

<figure class="lightly">
  <div class="scene">
    <Image
      src={lightly}
      alt="A small hedgehog tiptoes across the ground beside a sign that reads “Quicksands!”, saying “…lightly!”"
      widths={[780, 1560, lightly.width]}
      sizes="(max-width: 780px) 109vw, 773px"
    />
  </div>
  <blockquote class="sand" data-sand>
    <p>
      “It’s dark because you are trying too hard. Lightly child, lightly. Learn to do everything lightly. Yes, feel
      lightly even though you’re feeling deeply. Just lightly let things happen and lightly cope with them. I was so
      preposterously serious in those days, such a humorless little prig. Lightly, lightly – it’s the best advice ever
      given me. When it comes to dying even. Nothing ponderous, or portentous, or emphatic. No rhetoric, no tremolos,
      no self conscious persona putting on its celebrated imitation of Christ or Little Nell. And of course, no
      theology, no metaphysics. Just the fact of dying and the fact of the clear light. So throw away your baggage and
      go forward. There are quicksands all about you, sucking at your feet, trying to suck you down into fear and
      self-pity and despair. That’s why you must walk so lightly. Lightly my darling, on tiptoes and no luggage, not
      even a sponge bag, completely unencumbered.” ― Aldous Huxley, <cite>Island</cite>
    </p>
    <div class="grains" aria-hidden="true"><canvas data-surface={surface}></canvas></div>
  </blockquote>
</figure>

<script>
  import '../scripts/sand.ts';
</script>

<style>
  .lightly {
    margin: 2.2rem 0 0;
  }

  /* Scale, shift and crop the drawing as described above. Only blank paper is cropped. */
  .scene {
    overflow: hidden;
    aspect-ratio: 1833 / 282;
  }
  .scene :global(img) {
    display: block;
    width: 108.84%; /* 1995 / 1833 */
    max-width: none;
    margin: -3.82% 0 0 -4.47%; /* 70 / 1833 up, 82 / 1833 left */
  }

  .sand {
    position: relative;
    margin: 0;
    /* The sand thins out to nothing over the bottom padding. */
    padding: 3px 0 16px;
    /* Vertical swipes still scroll the page; sideways ones brush the sand. */
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .sand p {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.4;
    letter-spacing: 0;
    text-align: justify;
    hyphens: auto;
  }
  @media (max-width: 599px) {
    .sand p {
      font-size: 11.5px;
      line-height: 1.35;
    }
  }
  .grains {
    position: absolute;
    inset: 0;
    /* Reach up over the drawing to SAND_TOP: (352 - 298) / 1833 of the width. */
    margin-top: -2.946%;
    pointer-events: none;
  }
  .grains canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
