---
// Table of contents for a post. Two renderings of the same list: a fixed sidebar (≥1400px)
// and a collapsible "Contents" block above the article (<1400px). CSS shows one at a time.
import type { MarkdownHeading } from 'astro';
import { titleHtml } from '../lib/data';

interface Props {
  headings: MarkdownHeading[];
  title: string;
}
const { headings, title } = Astro.props;
const items = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
---

{
  items.length >= 2 && (
    <>
      <nav class="toc toc-sidebar" aria-label="Table of contents">
        <a class="toc-back" href="/blog/">
          ← Blog
        </a>
        <a class="toc-title" href="#top">
          <Fragment set:html={titleHtml(title)} />
        </a>
        <ul>
          {items.map((h) => (
            <li style={`--depth: ${h.depth - 2}`}>
              <a href={`#${h.slug}`} data-slug={h.slug}>
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <details class="toc toc-inline">
        <summary>Contents</summary>
        <nav aria-label="Table of contents">
          <ul>
            {items.map((h) => (
              <li style={`--depth: ${h.depth - 2}`}>
                <a href={`#${h.slug}`} data-slug={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>

      <script is:inline type="module">
        // Scroll-spy: highlight the section currently being read.
        (() => {
          const links = [...document.querySelectorAll('.toc a[data-slug]')];
          const headings = [...new Set(links.map((a) => a.dataset.slug))]
            .map((id) => document.getElementById(id))
            .filter(Boolean);
          let active;
          const update = () => {
            const line = window.innerHeight * 0.25;
            let current;
            for (const h of headings) {
              if (h.getBoundingClientRect().top <= line) current = h.id;
              else break;
            }
            if (current === active) return;
            active = current;
            for (const a of links) a.classList.toggle('active', a.dataset.slug === active);
          };
          const observer = new IntersectionObserver(update, { rootMargin: '0px 0px -75% 0px' });
          headings.forEach((h) => observer.observe(h));
          update();
        })();
      </script>
    </>
  )
}

<style>
  .toc {
    font-size: var(--small-size);
    line-height: 1.3;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    padding-left: calc(var(--depth) * 0.9em);
    margin: 0 0 0.55em;
  }
  li a {
    color: var(--text);
    opacity: 0.6;
    transition: opacity 0.2s ease, color 0.2s ease;
  }
  li a:hover {
    opacity: 1;
    text-decoration: none;
  }
  li a.active {
    opacity: 1;
    color: var(--accent);
  }

  .toc-sidebar {
    display: none;
    position: fixed;
    top: 60px;
    left: 0;
    width: 220px;
    box-sizing: content-box;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 0 40px;
  }
  .toc-back {
    display: block;
    margin-bottom: 12px;
    font-size: 0.9em;
    color: var(--text);
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .toc-back:hover {
    opacity: 1;
    text-decoration: none;
  }
  .toc-title {
    display: block;
    margin-bottom: 12px;
    font-weight: 600;
    color: var(--text);
    opacity: 0.65;
  }
  .toc-title:hover {
    opacity: 1;
    text-decoration: none;
  }

  .toc-inline {
    margin: 0 0 2rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .toc-inline summary {
    cursor: pointer;
    color: var(--text-2);
  }
  .toc-inline nav {
    margin-top: 0.7rem;
  }

  @media (min-width: 1400px) {
    .toc-sidebar {
      display: block;
    }
    .toc-inline {
      display: none;
    }
  }
</style>
