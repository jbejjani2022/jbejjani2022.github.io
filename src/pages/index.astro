---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import headshot from '../assets/headshot.png';
import MailLink from '../components/MailLink.astro';
import { SITE } from '../config';
---

<Base>
  <div class="wrap">
    <Header />
    <main class="landing">
      <h1 class="sr-only">{SITE.name}</h1>
      <Image
        src={headshot}
        alt="Photo of Joseph Bejjani"
        widths={[240, 480]}
        sizes="240px"
        loading="eager"
        fetchpriority="high"
        class="photo"
      />
      <div class="intro">
        <p>
          I'm a researcher working on understanding when and why AI systems fail to do what we intend or do what we "intend" in
          unexpected (and possibly harmful) ways. I aim to develop a clearer picture of how models generalize, so we can better predict, 
          and control, how tweaking some part of training changes a model's behavior. Towards this, I focus on model personas, 
          alignment evaluation, and multi-agent systems.

          I also think more broadly about what current and more powerful future AI systems mean for civilization, and how
          to safeguard human agency and self-determination.
        </p>
        <p>
          I’m pursuing a PhD in computer science at the University of Toronto co-advised by <a
            href="https://timrudner.com"
            target="_blank"
            rel="noopener">Tim Rudner</a
          > and <a href="https://www.cs.toronto.edu/~duvenaud/" target="_blank" rel="noopener">David Duvenaud</a>. I'm
          grateful to be supported by the <a href="https://vectorinstitute.ai" target="_blank" rel="noopener"
            >Vector Institute</a
          > and the <a href="https://www.cooperativeai.com" target="_blank" rel="noopener">Cooperative AI Foundation</a>.
        </p>
        <p>
          Feel free to <MailLink>reach out</MailLink>!
        </p>
        <p>
          Visiting (human or AI)? <a href="/guestbook/">Sign my guestbook</a>.
        </p>
      </div>
    </main>
  </div>
</Base>

<style>
  .landing {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    column-gap: 2.5rem;
    align-items: start;
    padding-top: 4vh;
  }
  .landing :global(.photo) {
    display: block;
    width: 100%;
    height: auto;
  }
  .intro p {
    margin: 0 0 1rem;
  }
  :global(body:has(.landing) .site-footer) {
    margin-top: 12vh;
  }

  @media (max-width: 599px) {
    .landing {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 0;
    }
    .landing :global(.photo) {
      max-width: 240px;
    }
    .intro {
      margin-top: 1.5rem;
    }
  }
</style>
