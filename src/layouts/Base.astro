---
// Main-site shell: fonts, tokens, <head> metadata, and the footer.
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '../styles/global.css';
import Head from '../components/Head.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  // Section title. The <title> becomes "{title} · Joseph Bejjani"; omit on the landing page.
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  // Extra class for the footer's wrapper, so it can line up with a shifted content column.
  wrapClass?: string;
}
const { title, description, type, wrapClass } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={fullTitle} description={description} type={type} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <div class:list={['wrap', wrapClass]}>
      <Footer />
    </div>
  </body>
</html>
